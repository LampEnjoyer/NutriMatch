{
  "_note": "Store-search settings per ingredient (keyed by normalized_name). Ingredients without a search term are searched by their normalized name. Kroger limits search terms to 3+ characters and at most 8 words.",
  "search_terms": {
    "chicken breast": "boneless skinless chicken breast",
    "ground beef": "85% lean ground beef",
    "ground turkey": "93% lean ground turkey",
    "shrimp": "raw shrimp peeled deveined",
    "canned tuna": "chunk light tuna in water",
    "egg": "large eggs",
    "heavy cream": "heavy whipping cream",
    "butter": "unsalted butter",
    "milk": "2% reduced fat milk",
    "greek yogurt": "plain nonfat greek yogurt",
    "cottage cheese": "low fat cottage cheese",
    "parmesan cheese": "grated parmesan cheese",
    "feta cheese": "crumbled feta cheese",
    "cheddar cheese": "shredded cheddar cheese",
    "mozzarella cheese": "shredded part skim mozzarella cheese",
    "fettuccine": "fettuccine pasta",
    "spaghetti": "spaghetti pasta",
    "penne": "penne pasta",
    "rolled oats": "old fashioned rolled oats",
    "corn tortilla": "corn tortillas",
    "broccoli": "broccoli florets",
    "mixed berries": "frozen mixed berries",
    "frozen peas": "frozen sweet peas",
    "canned chickpeas": "canned chickpeas garbanzo beans",
    "canned black beans": "canned black beans",
    "canned diced tomatoes": "canned diced tomatoes",
    "light coconut milk": "light coconut milk",
    "chicken broth": "low sodium chicken broth",
    "vegetable broth": "vegetable broth",
    "dried brown lentils": "dry brown lentils",
    "peanut butter": "creamy peanut butter",
    "soy sauce": "low sodium soy sauce",
    "sesame oil": "toasted sesame oil",
    "fresh ginger": "fresh ginger root",
    "cilantro": "fresh cilantro"
  },
  "_match_rules_note": "By default a product must contain every word of the ingredient name except generic ones (canned, fresh, frozen, low, plain...). 'require' replaces that: each group needs one of its words. 'exclude' rejects products containing any listed word.",
  "match_rules": {
    "butter": {"exclude": ["peanut", "almond", "cashew", "apple", "margarine", "spread", "cookie"]},
    "milk": {"exclude": ["coconut", "almond", "oat", "soy", "chocolate", "condensed", "evaporated", "powder", "lactose"]},
    "chicken breast": {"exclude": ["breaded", "nugget", "fried", "rotisserie", "tenderloin", "cooked"]},
    "shrimp": {"exclude": ["breaded", "cocktail", "cooked", "popcorn"]},
    "salmon fillet": {"require": [["salmon"]], "exclude": ["smoked", "canned", "pouch", "burger"]},
    "canned chickpeas": {"require": [["chickpea", "chick pea", "garbanzo"]]},
    "rolled oats": {"require": [["oats"]], "exclude": ["instant", "steel cut", "flavored", "maple", "brown sugar"]},
    "all-purpose flour": {"require": [["flour"], ["all purpose", "all-purpose"]]},
    "red bell pepper": {"require": [["red"], ["pepper"]], "exclude": ["flake", "crushed", "roasted", "jar", "seasoning"]},
    "green onion": {"require": [["green onion", "scallion"]]},
    "black pepper": {"exclude": ["lemon", "seasoned"]},
    "lemon": {"exclude": ["juice", "pepper", "lemonade", "yogurt", "tea", "cookie"]},
    "lime": {"exclude": ["juice", "chip", "seltzer", "soda"]},
    "garlic": {"exclude": ["powder", "salt", "bread", "pepper"]},
    "honey": {"exclude": ["mustard", "ham", "roasted", "cereal", "nut"]},
    "avocado": {"exclude": ["oil", "guacamole", "dip"]},
    "banana": {"exclude": ["chip", "bread", "pepper", "pudding"]},
    "cilantro": {"exclude": ["paste", "dressing", "rice"]},
    "olive oil": {"exclude": ["spray"]},
    "salt": {"exclude": ["garlic", "seasoned", "celery", "onion"]},
    "egg": {"require": [["egg"]], "exclude": ["noodle", "roll", "substitute", "nog", "egg white", "liquid", "eggplant"]}
  },
  "pantry_staples": ["salt", "black pepper"],
  "excluded": {
    "water": "Tap water. Nothing to buy.",
    "cooked white rice": "The recipe uses cooked rice, and converting that to an amount of dry rice to buy isn't supported yet."
  }
}
