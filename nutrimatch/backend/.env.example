# Copy to backend/.env. Every value here is optional; defaults are shown.

# SQLite for local work. For Postgres: postgresql+psycopg://user:pass@localhost:5432/nutrimatch
DATABASE_URL=sqlite:///./nutrimatch.db

# Comma-separated origins allowed to call the API directly (the Vite dev proxy doesn't need this).
CORS_ORIGINS=http://localhost:5173

# Until real auth exists, every request acts as this seeded user.
DEMO_USER_EMAIL=demo@nutrimatch.local

# USDA FoodData Central API key (free: https://fdc.nal.usda.gov/api-key-signup). Used from Phase 3.
USDA_FDC_API_KEY=
